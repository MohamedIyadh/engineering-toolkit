<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mohamed Iyad Engineering Toolkit</title><style>body{font-family:Segoe UI,sans-serif;background:#0f172a;color:#fff;margin:0}header{padding:20px;background:#111827;text-align:center}.wrap{padding:15px;max-width:1200px;margin:auto}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:15px}.card{background:#1e293b;border-radius:12px;padding:15px}.card h3{margin-top:0;color:#38bdf8}input,select{width:100%;padding:8px;margin:4px 0;border-radius:6px;border:none}.btn{background:#2563eb;color:white;padding:8px;border:none;border-radius:6px}.res{margin-top:8px;color:#facc15;font-weight:bold}.disc{font-size:12px;color:#cbd5e1;margin-top:20px}</style></head><body><header><h1>Mohamed Iyad Engineering Toolkit</h1><p>Chief Engineer Edition</p></header><div class=wrap><div class=grid>
<div class=card><h3>Ohm's Law</h3><input id=v placeholder='Voltage V'><input id=i placeholder='Current A'><input id=r placeholder='Resistance Ω'><button class=btn onclick='ohm()'>Calculate</button><div id=ohmr class=res></div></div>
<div class=card><h3>Power Factor</h3><input id=p placeholder='Active Power W'><input id=s placeholder='Apparent Power VA'><button class=btn onclick='pf()'>Calculate</button><div id=pfr class=res></div></div>
<div class=card><h3>Three Phase Current</h3><input id=kw3 placeholder='kW'><input id=v3 placeholder='Voltage'><input id=pf3 placeholder='PF' value='0.8'><button class=btn onclick='tp()'>Calculate</button><div id=tpr class=res></div></div>
<div class=card><h3>Voltage Drop</h3><input id=vd_i placeholder='Current A'><input id=vd_r placeholder='Resistance Ω'><button class=btn onclick='vd()'>Calculate</button><div id=vdr class=res></div></div>
<div class=card><h3>Transformer kVA</h3><input id=tkv placeholder='Voltage'><input id=tka placeholder='Current'><button class=btn onclick='tkva()'>Calculate</button><div id=tkvar class=res></div></div>
<div class=card><h3>Generator Loading</h3><input id=gcap placeholder='Generator kVA'><input id=gload placeholder='Load kVA'><button class=btn onclick='gloadf()'>Calculate</button><div id=gres class=res></div></div>
<div class=card><h3>UPS Runtime</h3><input id=ub placeholder='Battery Ah'><input id=uv placeholder='Battery V'><input id=ul placeholder='Load W'><button class=btn onclick='ups()'>Calculate</button><div id=ures class=res></div></div>
<div class=card><h3>ACH Calculator</h3><input id=cfm placeholder='Airflow m3/hr'><input id=vol placeholder='Room m3'><button class=btn onclick='ach()'>Calculate</button><div id=achr class=res></div></div>
<div class=card><h3>Cooling Load</h3><input id=area placeholder='Area m²'><button class=btn onclick='cool()'>Estimate</button><div id=coolr class=res></div></div>
<div class=card><h3>Tank Volume</h3><input id=dia placeholder='Diameter m'><input id=ht placeholder='Height m'><button class=btn onclick='tank()'>Calculate</button><div id=tankr class=res></div></div>
<div class=card><h3>Pump Head</h3><input id=suc placeholder='Suction m'><input id=dis placeholder='Discharge m'><button class=btn onclick='pump()'>Calculate</button><div id=pumpr class=res></div></div>
<div class=card><h3>Unit Converter</h3><input id=kw placeholder='kW'><button class=btn onclick='conv()'>Convert</button><div id=convr class=res></div></div>
</div><div class=disc><b>Disclaimer:</b> This toolkit was developed by Mohamed Iyad for personal use and reference. Results are estimates only and must not be used as the sole basis for engineering, safety, clinical, regulatory or operational decisions. Users are responsible for verifying all calculations and applicable standards. © Mohamed Iyad.</div></div><script>function n(id){return parseFloat(document.getElementById(id).value)};function ohm(){let V=n('v'),I=n('i'),R=n('r');let c=[V,I,R].filter(x=>!isNaN(x)).length;if(c!=2)return ohmr.innerText='Enter exactly 2 values'; if(isNaN(V))ohmr.innerText='V='+ (I*R).toFixed(2)+' V'; else if(isNaN(I))ohmr.innerText='I='+(V/R).toFixed(2)+' A'; else ohmr.innerText='R='+(V/I).toFixed(2)+' Ω';}function pf(){pfr.innerText='PF='+(n('p')/n('s')).toFixed(3)}function tp(){tpr.innerText='Current='+((n('kw3')*1000)/(1.732*n('v3')*n('pf3'))).toFixed(2)+' A'}function vd(){vdr.innerText='Drop='+(n('vd_i')*n('vd_r')).toFixed(2)+' V'}function tkva(){tkvar.innerText='kVA='+((n('tkv')*n('tka'))/1000).toFixed(2)}function gloadf(){gres.innerText='Loading='+((n('gload')/n('gcap'))*100).toFixed(1)+' %'}function ups(){ures.innerText='Runtime≈'+((n('ub')*n('uv')*0.8)/n('ul')).toFixed(2)+' hr'}function ach(){achr.innerText='ACH='+(n('cfm')/n('vol')).toFixed(2)}function cool(){coolr.innerText='Approx '+(n('area')*600/1000).toFixed(1)+' kW'}function tank(){let v=3.1416*Math.pow(n('dia')/2,2)*n('ht');tankr.innerText='Volume='+v.toFixed(2)+' m³'}function pump(){pumpr.innerText='Head='+(n('suc')+n('dis')).toFixed(2)+' m'}function conv(){convr.innerText=n('kw')+' kW = '+(n('kw')*1000).toFixed(0)+' W'};</script></body></html>
